#!/sbin/sh
OUTFD=$2
ZIPFILE=$3

ui_print() {
  echo -e "ui_print $1\nui_print" >> /proc/self/fd/$OUTFD
}

MODPATH="/data/adb/modules/samsung_lag_fix"
mkdir -p "$MODPATH"
unzip -o "$ZIPFILE" -d "$MODPATH" >/dev/null 2>&1

set_perm_recursive() {
  find "$1" -type d -exec chmod "$2" {} +
  find "$1" -type f -exec chmod "$3" {} +
}
set_perm_recursive "$MODPATH" 0755 0644
chmod 0755 "$MODPATH"/*.sh 2>/dev/null

[ -f "$MODPATH/customize.sh" ] && . "$MODPATH/customize.sh"

ui_print "************************************"
ui_print " 三星软重启流畅优化 v1.5.8 (纯净版)"
ui_print " 作者: 黑白君"
ui_print " 模块安装成功！"
ui_print "************************************"
exit 0

